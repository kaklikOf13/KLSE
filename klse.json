{
    "name":"klse",
    "version":"1.0",
    "task":{
        "build":{
            "childs":{
                "klse":{
                    "task":"klse build-dir & klse compile-folder c++ dist/obj src/KLSE '-I./includes'"
                },
                "cli":{
                    "task":"pyinstaller --onefile --distpath dist/bin --icon=assets/icons/icon.ico src/CLI/main.py"
                }
            }
        }
    }
}