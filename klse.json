{
    "name":"klse",
    "version":"1.0",
    "task":{
        "build":{
            "childs":{
                "klse":{
                    "build":{
                        "includes":["./includes"],
                        "libs_dir":[],
                        "lib_output":"dist/libs/klse",
                        "o_output":"dist/obj/klse",
                        "source":[
                            "src/KLSE/KLSE",
                            "src/KLSE/KLSE/basics",
                            "src/KLSE/KLSE/net",
                            "src/KLSE/KLSE/others",
                            "src/KLSE/KLSE/physics",
                            "src/KLSE/KLSE/rendering",
                            "src/KLSE/KLSE/sources"
                        ]
                    },
                    "childs":{
                        "gl":{
                            "build":{
                                "includes":["./includes"],
                                "libs_dir":[],
                                "lib_output":"dist/libs/klse_gl",
                                "o_output":"dist/obj/klse_gl",
                                "source":[
                                    "src/KLSE/GL"
                                ]
                            }
                        },
                        "glfw":{
                            "build":{
                                "includes":["./includes"],
                                "libs_dir":[],
                                "lib_output":"dist/libs/klse_glfw",
                                "o_output":"dist/obj/klse_glfw",
                                "source":[
                                    "src/KLSE/GLFW"
                                ]
                            }
                        },
                        "full":{
                            "task":"klse task build klse & klse task build klse gl & klse task build klse glfw"
                        }
                    }
                },
                "cli":{
                    "windows":"pyinstaller --onefile --distpath dist/bin --icon=assets/icons/icon.ico src/CLI/klse.py",
                    "posix":"pyinstaller  --onefile --distpath dist/bin --icon=assets/icons/icon.ico src/CLI/klse.py"
                },
                "tests":{
                    "childs":{
                        "window":{
                            "build":{
                                "includes":["./includes"],
                                "libs_dir":["./dist/libs"],
                                "libs":[
                                    "klse",
                                    "gl"
                                ],
                                "bin_main":"src/tests/window.cpp",
                                "bin_output":"dist/bin/tests/window",
                                "pre_tasks":["build klse full"]
                            }
                        },
                        "objects2d":{
                            "build":{
                                "includes":["./includes"],
                                "libs_dir":["./dist/libs"],
                                "libs":[
                                    "klse",
                                    "gl"
                                ],
                                "bin_main":"src/tests/objects2d.cpp",
                                "bin_output":"dist/bin/tests/objects2d",
                                "pre_tasks":["build klse full"]
                            }
                        }
                    }
                }
            }
        }
    },
    "tests":[
        "src/tests"
    ]
}