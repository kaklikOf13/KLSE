{
    "name":"klse",
    "version":"1.0",
    "windows_tasks":{
        "task":"klse task windows lib && klse task windows executable && klse task windows gfx",
        "childs":{
            "lib":{
                "task":"klse compile-static-lib KLSE dist/windows \"-fPIC -I./includes -I./includes-exe -L./libs\""
            },
            "lib-wasm":{
                "task":"klse generate-wasm KLSE dist/wasm \"-fPIC -I./includes -L./libs\""
            },
            "executable":{
                "task":"klse build-dir dist/windows/bin/main && g++ src/EXE/main.cpp -L./dist/windows/libs -lKLSE -I./includes -o dist/windows/bin/main/klse.exe"
            },
            "test-compile":{
                "childs":{
                    "window":{
                        "task":"g++ src/tests/window.cpp -L./dist/windows/libs -I./includes -lKLSE-GFX -lKLSE -lglfw3 -lgdi32 -lopengl32 -ldwmapi -o dist/windows/bin/tests/window.exe"
                    },
                    "collision2D":{
                        "task":"g++ src/tests/collision2D.cpp -L./dist/windows/libs -I./includes -lKLSE-GFX -lKLSE -lglfw3 -lgdi32 -lopengl32 -ldwmapi -o dist/windows/bin/tests/collision2D.exe"
                    },
                    "minigames":{
                        "task":"klse build-dir dist/windows/bin/tests/minigames",
                        "childs":{
                            "flappybird":{
                                "task":"g++ src/tests/minigames/flappybird.cpp -L./dist/windows/libs -I./includes -lKLSE-GFX -lKLSE -lglfw3 -lgdi32 -lopengl32 -ldwmapi -o dist/windows/bin/tests/minigames/flappybird.exe"
                            },
                            "space":{
                                "task":"g++ src/tests/minigames/space.cpp -L./dist/windows/libs -I./includes -lKLSE-GFX -lKLSE -lglfw3 -lgdi32 -lopengl32 -ldwmapi -o dist/windows/bin/tests/minigames/space.exe"
                            }
                        }
                    }
                },
                "task":"klse build-dir dist/windows/bin/tests && klse task windows test-compile window && klse task windows test-compile collision2D"
            },
            "test":{
                "childs":{
                    "window":{
                        "task":"klse task windows lib && klse task windows gfx && klse task windows test-compile && \"dist/windows/bin/tests/window.exe\""
                    },
                    "collision2D":{
                        "task":"klse task windows lib && klse task windows gfx && klse task windows test-compile && \"dist/windows/bin/tests/collision2D.exe\""
                    },
                    "minigames":{
                        "task":"klse build-dir dist/windows/bin/tests/minigames",
                        "childs":{
                            "flappybird":{
                                "task":"klse task windows lib && klse task windows gfx && klse task windows test-compile minigames && klse task windows test-compile minigames flappybird && \"dist/windows/bin/tests/minigames/flappybird.exe\""
                            },
                            "space":{
                                "task":"klse task windows lib && klse task windows gfx && klse task windows test-compile minigames && klse task windows test-compile minigames space && \"dist/windows/bin/tests/minigames/space.exe\""
                            }
                        }
                    }
                },
                "task":""
            },
            "gfx":{
                "task":"klse compile-static-lib KLSE/GFX dist/windows \"-fPIC -I./includes -L./dist/windows/libs\""
            }
        }
    }
}