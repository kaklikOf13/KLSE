{
    "name":"klse",
    "version":"1.0",
    "task":{
        "build":{
            "childs":{
                "klse":{
                    "task":"klse build-dir",
                    "build":{
                        "includes":["./includes"],
                        "libs_dir":[],
                        "lib_output":"dist/libs/klse",
                        "o_output":"dist/obj/klse",
                        "source":[
                            "src/KLSE/KLSE",
                            "src/KLSE/KLSE/basics",
                            "src/KLSE/KLSE/net",
                            "src/KLSE/KLSE/others",
                            "src/KLSE/KLSE/physics",
                            "src/KLSE/KLSE/rendering",
                            "src/KLSE/KLSE/sources"
                        ]
                    },
                    "childs":{
                        "gl":{
                            "build":{
                                "includes":["./includes"],
                                "libs_dir":[],
                                "lib_output":"dist/libs/klse_gl",
                                "o_output":"dist/obj/klse_gl",
                                "source":[
                                    "src/KLSE/GL"
                                ]
                            }
                        },
                        "glfw":{
                            "build":{
                                "includes":["./includes"],
                                "libs_dir":[],
                                "lib_output":"dist/libs/klse_glfw",
                                "o_output":"dist/obj/klse_glfw",
                                "source":[
                                    "src/KLSE/GLFW"
                                ]
                            }
                        },
                        "full":{
                            "task":"klse task build klse & klse task build klse gl & klse task build klse glfw"
                        }
                    }
                },
                "cli":{
                    "windows":"pyinstaller --onefile --distpath dist/bin --icon=assets/icons/icon.ico src/CLI/main.py",
                    "posix":"pyinstaller  --onefile --distpath dist/bin --icon=assets/icons/icon.ico src/CLI/main.py"
                },
                "tests":{
                    "childs":{
                        "window":{
                            "task":"klse task build klse full",
                            "posix":"g++ src/tests/window.cpp -L./dist/libs -I./includes -lklse_gl -lklse_glfw -lklse -lglfw -lGL -ldl -lpthread -o dist/bin/tests/window",
                            "windows":"g++ src/tests/window.cpp -L./dist/libs -I./includes -lklse_gl -lklse_glfw -lklse -lglfw3 -lgdi32 -ldwmapi -o dist/bin/tests/window.exe"
                        },
                        "objects2d":{
                            "task":"klse task build klse full & g++ src/tests/objects2d.cpp -L./dist/libs -I./includes -lklse_gl -lklse_glfw -lklse -lglfw3 -lgdi32 -lopengl32 -ldwmapi -o dist/bin/tests/objects.exe"
                        }
                    }
                }
            }
        }
    },
    "tests":[
        "src/tests"
    ]
}